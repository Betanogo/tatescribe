{
  "id": "./",
  "name": "TateScribe",
  "short_name": "TateScribe",
  "description": "AI transcription that keeps up when you switch languages mid-sentence",
  "lang": "en",
  "start_url": "./#/",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#F4F6F8",
  "theme_color": "#2442C4",
  "categories": ["productivity", "utilities"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "New transcription", "short_name": "Upload", "url": "./#/new", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "All transcripts", "short_name": "Transcripts", "url": "./#/", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": { "url": "url", "text": "text" }
  }
}
